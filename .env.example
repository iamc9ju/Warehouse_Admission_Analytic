# ==============================================================================
# Production Runtime Environment Variables (Template)
# Copy this file to .env and fill in the actual values before running container.
# Never pass secrets via docker build --build-arg.
# ==============================================================================

# Server runtime & basePath configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
HOSTNAME=0.0.0.0
BASE_PATH=/admission-eng
NEXT_PUBLIC_BASE_PATH=/admission-eng

# PostgreSQL / Neon Database Connection String (Required at runtime)
# Example (Docker network PostgreSQL):
# DATABASE_URL=postgresql://postgres:your_password@admissions-db:5432/admissions_dw?sslmode=disable
# Example (Neon Serverless PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google Gemini API Configuration for /ai-analysis (Required for AI report generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ETL Student Tokenization Salt (Required only when running ETL CLI, minimum 16 chars)
ADMISSIONS_STUDENT_HASH_SALT=
